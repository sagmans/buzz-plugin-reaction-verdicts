#!/usr/bin/env bash
# One entry point for this repository's own checks, so the git hooks and
# contributors run exactly the same commands. The generic template checks in
# .githooks/lib (secrets, commit messages, osv-scanner, lizard, vendored
# semgrep rules) run on their own; these cover what is specific to a
# plain-JavaScript Buzz plugin that is published as is, with no build step.
#
# Usage: scripts/check [STEP...]
#   js             node --check on every JavaScript file; every JSON file parses
#   biome          biome lint and format on JavaScript and JSON at the mise.toml pin
#   shell          shellcheck and shfmt on this repository's own shell scripts
#   markdown       markdownlint-cli2 with the hook template's strict config
#   complexity     lizard CCN and length check across every JavaScript file
#   personal-data  no personal paths, tailnet names, tracker ids or keys
#   dogfood        scripts/dogfood.mjs: the plugin with a fake Buzz host
#   semgrep        semgrep with the p/javascript registry rules (network)
#   trivy          trivy secret and misconfiguration scan (network)
# Without a STEP it runs every offline step (js biome shell markdown complexity personal-data dogfood).
#
# Files to judge are the ones git tracks in the index (GIT_INDEX_FILE is
# honoured); their content is read below CHECK_ROOT (default: the repository
# top). The pre-commit hook points CHECK_ROOT at a snapshot of the staged
# index, so a partly staged file is judged by what will be committed.
set -euo pipefail

CHECK=check
OFFLINE_STEPS=(js biome shell markdown complexity personal-data dogfood)
# Network scanners must not hang a push forever.
SCAN_TIMEOUT_SECONDS=300
SEMGREP_CONFIG=p/javascript
TRIVY_SCANNERS=secret,misconfig
MARKDOWN_CONFIG=.githooks/lib/markdownlint.jsonc
BIOME_CONFIG=biome.json
MISE_CONFIG=mise.toml
# Shared hook template files (.githooks/<hook> and .githooks/lib/*) are owned
# by the template repository; repo-owned .githooks/*.d/* still runs checks.
TEMPLATE_HOOK_RE='^\.githooks/lib/|^\.githooks/[^/]+$'
# Patterns for reading the pinned Biome version from mise.toml and CLI output.
MISE_SECTION_RE='^[[:space:]]*\[([^]]+)\][[:space:]]*$'
MISE_BIOME_PIN_RE='^[[:space:]]*biome[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)"[[:space:]]*$'
BIOME_VERSION_RE='Version:[[:space:]]*([0-9]+\.[0-9]+\.[0-9]+)'
# Complexity limits match the generic changed-function check, applied across
# every file so old functions cannot drift past them unnoticed.
LIZARD_MAX_CCN=15
LIZARD_MAX_LENGTH=100
# Security floor: carries the November 2026 Node.js CVE fixes.
NODE_MIN_VERSION=24.22.3
# Minimum versions: the releases these flags and rule sets were verified with.
SHELLCHECK_MIN_VERSION=0.10.0
SHFMT_MIN_VERSION=3.8.0
MARKDOWNLINT_MIN_VERSION=0.23.2
LIZARD_MIN_VERSION=1.24.1
SEMGREP_MIN_VERSION=1.182.0
TRIVY_MIN_VERSION=0.60.0
DOGFOOD=scripts/dogfood.mjs
PLUGIN_MODULE=plugin/plugin.js
# The repository's own shell: hook checks and scripts. The generic template
# files are linted where the template lives, and are never edited here.
OWN_SHELL_GLOBS=('.githooks/*.d/*' 'scripts/check')
# Optional shellcheck rules turned off, each a style choice that finds no bug:
# SC2250: braces around every variable; the hook template does not use them.
# SC2310: functions here return explicit statuses that every caller checks, so
#         no step relies on set -e inside a function called in a condition.
SHELLCHECK_EXCLUDES=(-e SC2250 -e SC2310)
# Generic patterns only, never a real name: home directories, private agent
# workspace paths, tailnet hosts, the private tracker, Nostr keys and 64-hex
# public keys or ids. Each is written so that it does not match itself.
PERSONAL_DATA_PATTERNS=(
	'[/](Users|home)[/][A-Za-z0-9._-]+[/]'
	'~[/][.]buzz([/]|$)'
	'~[/]source[/]'
	'[.]tail[0-9a-f]+[.]ts[.]net'
	'(npub|nsec)1[02-9ac-hj-np-z]{20,}'
	'(^|[^0-9a-f])[0-9a-f]{64}([^0-9a-f]|$)'
)

top=$(git rev-parse --show-toplevel)
top=$(cd "$top" && pwd -P)
root=$(cd "${CHECK_ROOT:-$top}" && pwd -P)
# The checkout that holds this script owns the tool helpers and the lint
# config. The pre-push hook runs this script in a worktree of an older
# commit, which may not have them yet.
checks_top=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
# shellcheck source=SCRIPTDIR/../.githooks/lib/tools.sh
. "$checks_top/.githooks/lib/tools.sh"
# run_with_timeout, which the network scanners below need, lives here.
# shellcheck source=SCRIPTDIR/../.githooks/lib/helpers.sh
. "$checks_top/.githooks/lib/helpers.sh"

# Resolve pinned CLI tools directly from the trusted checkout's mise.toml
# before shims or ambient PATH, and ignore any untrusted mise.toml inside a
# temporary staged snapshot or commit worktree.
use_mise_tools() {
	local mise_dir=$1 checked_dir=$2 bins dir prefix=""
	if [[ $checked_dir != "$mise_dir" ]]; then
		MISE_IGNORED_CONFIG_PATHS="${MISE_IGNORED_CONFIG_PATHS:+$MISE_IGNORED_CONFIG_PATHS:}$checked_dir"
		export MISE_IGNORED_CONFIG_PATHS
	fi
	command -v mise >/dev/null 2>&1 || return 0
	[[ ! -L "$mise_dir/$MISE_CONFIG" && -f "$mise_dir/$MISE_CONFIG" ]] || return 0
	bins=$(MISE_OFFLINE=1 mise -C "$mise_dir" bin-paths </dev/null 2>/dev/null || true)
	[[ -n $bins ]] || return 0
	while IFS= read -r dir; do
		[[ -n $dir ]] || continue
		prefix="${prefix:+$prefix:}$dir"
	done <<<"$bins"
	[[ -z $prefix ]] || PATH="$prefix:$PATH"
	export PATH
}
# Pre-commit runs against a staged snapshot ($CHECK_ROOT) from the working tree
# ($top); pre-push runs from the trusted checkout ($checks_top).
if [[ -n ${CHECK_ROOT:-} ]]; then
	use_mise_tools "$top" "$root"
else
	use_mise_tools "$checks_top" "$root"
fi

# tracked <glob>... -- print tracked paths that match a glob, one per line.
# Callers capture the list before they loop, so a git failure stops the step
# instead of looking like an empty repository (fail closed).
tracked() {
	git -C "$top" ls-files -- "$@"
}

# Exact Biome version pinned under [tools] in mise.toml, so an outdated
# install or a weakened pin in a staged commit fails closed.
biome_pinned_version() {
	local file=$1 line in_tools=0
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%%#*}
		if [[ $line =~ $MISE_SECTION_RE ]]; then
			if [[ ${BASH_REMATCH[1]} == tools ]]; then
				in_tools=1
			else
				in_tools=0
			fi
			continue
		fi
		if [[ $in_tools -eq 1 && $line =~ $MISE_BIOME_PIN_RE ]]; then
			printf '%s\n' "${BASH_REMATCH[1]}"
			return 0
		fi
	done <"$file"
	return 1
}

step_js() {
	local path scripts data
	require_tool "$CHECK" node "$NODE_MIN_VERSION" 'install Node.js (mise install, see mise.toml)' node --version || return 1
	scripts=$(tracked '*.js' '*.mjs' '*.cjs') || return 1
	data=$(tracked '*.json') || return 1
	while IFS= read -r path; do
		[[ -n $path ]] || continue
		node --check "$root/$path" || {
			echo >&2 "❌ js: $path does not parse"
			return 1
		}
	done <<<"$scripts"
	while IFS= read -r path; do
		[[ -n $path ]] || continue
		node -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$root/$path" ||
			{
				echo >&2 "❌ js: $path is not valid JSON"
				return 1
			}
	done <<<"$data"
	echo "check js: ok"
}

# Keep JS and JSON formatting and lint aligned with biome.json, using only
# the exact Biome version pinned in mise.toml so local hooks never drift.
step_biome() {
	local files=() list path config_root config_file pin_file pinned biome_bin out version
	list=$(tracked '*.js' '*.mjs' '*.cjs' '*.json') || return 1
	while IFS= read -r path; do
		[[ -n $path ]] || continue
		[[ $path =~ $TEMPLATE_HOOK_RE ]] && continue
		files+=("$path")
	done <<<"$list"
	[[ ${#files[@]} -gt 0 ]] || {
		echo "check biome: nothing to check"
		return 0
	}
	# Pre-commit sets CHECK_ROOT to the staged snapshot so a broken biome.json
	# or mise.toml pin cannot be committed; pre-push judges every commit in the
	# range against the trusted checkout's active config and pin.
	if [[ -n ${CHECK_ROOT:-} ]]; then
		config_root=$root
	else
		config_root=$checks_top
	fi
	config_file=$config_root/$BIOME_CONFIG
	pin_file=$config_root/$MISE_CONFIG
	if [[ -L $config_file || ! -f $config_file ]]; then
		echo >&2 "❌ biome: $BIOME_CONFIG is missing or a symlink at $config_file"
		return 1
	fi
	if [[ -L $pin_file || ! -f $pin_file ]]; then
		echo >&2 "❌ biome: $MISE_CONFIG is missing or a symlink at $pin_file"
		return 1
	fi
	pinned=$(biome_pinned_version "$pin_file") || {
		echo >&2 "❌ biome: pin an exact biome = \"X.Y.Z\" version under [tools] in $MISE_CONFIG"
		return 1
	}
	biome_bin=$(command -v biome 2>/dev/null || true)
	if [[ -z $biome_bin ]]; then
		echo >&2 "❌ biome: biome $pinned not found; run: mise install"
		return 1
	fi
	out=$("$biome_bin" --version 2>/dev/null || true)
	if ! [[ $out =~ $BIOME_VERSION_RE ]]; then
		echo >&2 "❌ biome: cannot read the biome version from '$biome_bin --version'"
		return 1
	fi
	version=${BASH_REMATCH[1]}
	if [[ $version != "$pinned" ]]; then
		echo >&2 "❌ biome: biome $version does not match $MISE_CONFIG pin $pinned; run: mise install"
		return 1
	fi
	(cd "$root" && "$biome_bin" check --config-path="$config_file" --error-on-warnings -- "${files[@]}") || {
		echo >&2 "❌ biome: lint or format findings (mise exec -- biome check --write .)"
		return 1
	}
	echo "check biome: ok (${#files[@]} files)"
}

step_shell() {
	local files=() list path
	require_tool "$CHECK" shellcheck "$SHELLCHECK_MIN_VERSION" 'install shellcheck (brew install shellcheck)' shellcheck --version || return 1
	require_tool "$CHECK" shfmt "$SHFMT_MIN_VERSION" 'install shfmt (mise install, see mise.toml)' shfmt --version || return 1
	list=$(tracked "${OWN_SHELL_GLOBS[@]}") || return 1
	while IFS= read -r path; do [[ -z $path ]] || files+=("$root/$path"); done <<<"$list"
	[[ ${#files[@]} -gt 0 ]] || {
		echo "check shell: nothing to check"
		return 0
	}
	# -o all: every optional rule on; -x: follow the sourced hook helpers.
	shellcheck -x -o all "${SHELLCHECK_EXCLUDES[@]}" "${files[@]}" ||
		{
			echo >&2 "❌ shell: shellcheck findings"
			return 1
		}
	shfmt -d -s "${files[@]}" || {
		echo >&2 "❌ shell: run shfmt -w -s on the files above"
		return 1
	}
	echo "check shell: ok (${#files[@]} files)"
}

step_markdown() {
	local files=() list path
	require_tool "$CHECK" markdownlint-cli2 "$MARKDOWNLINT_MIN_VERSION" 'install markdownlint-cli2 (mise install, see mise.toml)' markdownlint-cli2 --help || return 1
	list=$(tracked '*.md') || return 1
	while IFS= read -r path; do [[ -z $path ]] || files+=("$path"); done <<<"$list"
	[[ ${#files[@]} -gt 0 ]] || return 0
	(cd "$root" && markdownlint-cli2 --config "$checks_top/$MARKDOWN_CONFIG" "${files[@]}") ||
		{
			echo >&2 "❌ markdown: findings (markdownlint-cli2 --fix <file>)"
			return 1
		}
	echo "check markdown: ok (${#files[@]} files)"
}

step_complexity() {
	local files=() list path
	require_tool "$CHECK" lizard "$LIZARD_MIN_VERSION" 'install lizard (mise install, see mise.toml)' lizard --version || return 1
	list=$(tracked '*.js' '*.mjs' '*.cjs') || return 1
	while IFS= read -r path; do
		[[ -n $path ]] || continue
		[[ $path =~ $TEMPLATE_HOOK_RE ]] && continue
		if [[ ! -f "$root/$path" ]]; then
			echo >&2 "❌ complexity: missing file $path"
			return 1
		fi
		files+=("$root/$path")
	done <<<"$list"
	[[ ${#files[@]} -gt 0 ]] || return 0
	lizard --CCN "$LIZARD_MAX_CCN" --length "$LIZARD_MAX_LENGTH" --warnings_only "${files[@]}" || {
		echo >&2 "❌ complexity: a function is above CCN $LIZARD_MAX_CCN or $LIZARD_MAX_LENGTH lines"
		return 1
	}
	echo "check complexity: ok (${#files[@]} files)"
}

step_personal_data() {
	local args=() pattern found=0 path out rc list
	list=$(tracked '*') || return 1
	for pattern in "${PERSONAL_DATA_PATTERNS[@]}"; do args+=(-e "$pattern"); done
	while IFS= read -r path; do
		[[ -n $path ]] || continue
		# -I skips binary files. grep exits 1 for no match; any other failure
		# means the file was not scanned, which must block like a finding.
		rc=0
		out=$(grep -n -I -i -E "${args[@]}" -- "$root/$path") || rc=$?
		case "$rc" in
		0)
			found=1
			printf '%s\n' "$out" | sed "s#^#$path:#" >&2
			;;
		1) ;;
		*)
			echo >&2 "❌ personal-data: cannot scan $path (grep status $rc)"
			return 1
			;;
		esac
	done <<<"$list"
	if [[ $found -ne 0 ]]; then
		echo >&2 "❌ personal-data: replace the lines above with neutral examples (the user, example.ts.net)"
		return 1
	fi
	echo "check personal-data: ok"
}

step_dogfood() {
	# Commits from before the dogfood run existed have nothing to run. The
	# pre-push hook judges every pushed commit, those included.
	[[ -f "$root/$DOGFOOD" ]] || {
		echo "check dogfood: skipped, $DOGFOOD is not in this tree"
		return 0
	}
	[[ -f "$root/$PLUGIN_MODULE" ]] || {
		echo >&2 "❌ dogfood: $DOGFOOD exists but $PLUGIN_MODULE is missing"
		return 1
	}
	require_tool "$CHECK" node "$NODE_MIN_VERSION" 'install Node.js (mise install, see mise.toml)' node --version || return 1
	node "$root/$DOGFOOD" --plugin "$root/$PLUGIN_MODULE"
}

step_semgrep() {
	local rc=0
	require_tool "$CHECK" semgrep "$SEMGREP_MIN_VERSION" 'install semgrep (brew install semgrep)' semgrep --version || return 1
	run_with_timeout "$SCAN_TIMEOUT_SECONDS" semgrep scan --config "$SEMGREP_CONFIG" \
		--metrics=off --disable-version-check --error --quiet "$root" || rc=$?
	[[ $rc -ne 124 ]] || echo >&2 "❌ semgrep: no result after ${SCAN_TIMEOUT_SECONDS}s"
	[[ $rc -eq 0 ]] || {
		echo >&2 "❌ semgrep: findings or scanner error (status $rc)"
		return 1
	}
	echo "check semgrep: ok"
}

step_trivy() {
	local rc=0
	require_tool "$CHECK" trivy "$TRIVY_MIN_VERSION" 'install trivy (brew install trivy)' trivy --version || return 1
	run_with_timeout "$SCAN_TIMEOUT_SECONDS" trivy fs --scanners "$TRIVY_SCANNERS" --exit-code 1 \
		--quiet --skip-version-check --disable-telemetry "$root" || rc=$?
	[[ $rc -ne 124 ]] || echo >&2 "❌ trivy: no result after ${SCAN_TIMEOUT_SECONDS}s"
	[[ $rc -eq 0 ]] || {
		echo >&2 "❌ trivy: findings or scanner error (status $rc)"
		return 1
	}
	echo "check trivy: ok"
}

main() {
	local steps=("$@") name
	[[ ${#steps[@]} -gt 0 ]] || steps=("${OFFLINE_STEPS[@]}")
	for name in "${steps[@]}"; do
		case "$name" in
		js | biome | shell | markdown | complexity | personal-data | dogfood | semgrep | trivy) "step_${name//-/_}" ;;
		*)
			echo >&2 "❌ check: unknown step '$name' (see the usage at the top of scripts/check)"
			return 2
			;;
		esac
	done
}

main "$@"
